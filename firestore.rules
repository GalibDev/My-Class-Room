rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function cr() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cr'; }
  function member() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
  match /users/{uid} {
   allow read: if member() && (cr() || resource.data.role == 'student' || request.auth.uid == uid);
   allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','roll','role']) && request.resource.data.role == 'student' && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 && request.resource.data.roll is string && request.resource.data.roll.matches('[0-9]{1,20}');
   allow update, delete: if false;
  }
  match /sessions/{id} {
   allow read: if member();
   allow create, update: if cr() && request.resource.data.keys().hasOnly(['subject','date','open']) && request.resource.data.subject in ['cse201','cse203','cse205'] && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && id == request.resource.data.subject + '_' + request.resource.data.date && request.resource.data.open is bool;
  }
  match /attendance/{id} {
   allow read: if cr() || (member() && resource.data.studentId == request.auth.uid);
   function valid() { return request.resource.data.keys().hasOnly(['studentId','subject','date','status']) && request.resource.data.studentId is string && request.resource.data.subject in ['cse201','cse203','cse205'] && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && id == request.resource.data.subject + '_' + request.resource.data.date + '_' + request.resource.data.studentId; }
   function studentRequest() { return member() && request.resource.data.studentId == request.auth.uid && request.resource.data.status == 'pending' && get(/databases/$(database)/documents/sessions/$(request.resource.data.subject + '_' + request.resource.data.date)).data.open == true; }
   allow create: if valid() && ((cr() && request.resource.data.status in ['present','absent']) || studentRequest());
   allow update: if valid() && request.resource.data.studentId == resource.data.studentId && request.resource.data.subject == resource.data.subject && request.resource.data.date == resource.data.date && ((cr() && request.resource.data.status in ['present','absent']) || (studentRequest() && resource.data.status != 'present'));
  }
 }
}
